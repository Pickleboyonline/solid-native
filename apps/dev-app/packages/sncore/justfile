build-all:
    cargo build --release
    mkdir -p build/bindings/swift
    mkdir -p build/bindings/kotlin
    cargo run --bin uniffi-bindgen generate --library target/release/libsncore.dylib --language kotlin --out-dir build/bindings/kotlin
    cargo run --bin uniffi-bindgen generate --library target/release/libsncore.dylib --language swift --out-dir build/bindings/swift


build-ios:
    mkdir -p build/swift
    cargo swift package -p macos ios -n SNCore -y
    rm -rf ./generated
    rm -rf ./build/swift/SNCore
    mv SNCore build/swift

build-android:
    cargo ndk -t armeabi-v7a -t arm64-v8a -t x86_64 -o ./android-sncore/src/main/jniLibs build --release
    cargo run --bin uniffi-bindgen generate --library target/release/libsncore.dylib --language kotlin --out-dir ./android-sncore/src/main/java

