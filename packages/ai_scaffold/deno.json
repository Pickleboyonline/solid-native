{
  "name": "@solid-native/scaffold",
  "version": "0.1.0",
  "exports": "./mod.ts",

  "tasks": {
    "dev": "deno run --allow-all --watch src/cli/dev.ts",
    "build": "deno run --allow-all src/cli/build.ts",
    "start": "deno run --allow-all src/cli/start.ts",
    "scaffold": "deno run --allow-all src/cli/scaffold.ts",
    "ai": "deno run --allow-all src/cli/ai.ts",
    "doctor": "deno run --allow-all src/cli/doctor.ts",
    "test": "deno test --allow-all",
    "check": "deno check **/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },

  "imports": {
    "@solid-native/core": "jsr:@solid-native/core@^0.1.0",
    "@solid-native/runtime": "jsr:@solid-native/runtime@^0.1.0",
    "solid-js": "npm:solid-js@^1.9.0",
    "solid-js/store": "npm:solid-js@^1.9.0/store",
    "solid-js/web": "npm:solid-js@^1.9.0/web",
    "@anthropic/sdk": "npm:@anthropic-ai/sdk@^0.31.0",
    "openai": "npm:openai@^4.72.0",
    "zod": "npm:zod@^3.24.0",
    "cliffy": "jsr:@cliffy/command@^1.0.0-rc.7",
    "std/": "jsr:@std/",
    "ts-morph": "npm:ts-morph@^24.0.0"
  },

  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  },

  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },

  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },

  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".solid-native"
  ]
}
